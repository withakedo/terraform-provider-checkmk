# CheckMK Terraform Provider - Environment Configuration
#
# Copy this file to .env and configure with your credentials.
# IMPORTANT: Never commit .env to version control!

# =============================================================================
# Docker Registry Credentials (Required for Enterprise Edition)
# =============================================================================
# Get credentials from: https://checkmk.com/download
# Not needed if using --edition=raw
CHECKMK_DOCKER_USERNAME=your_username
CHECKMK_DOCKER_PASSWORD=your_password

# =============================================================================
# Usage
# =============================================================================
# Generate docker-compose.yml:
#   python3 scripts/generate-compose.py -o docker-compose.yml
#
# With options:
#   python3 scripts/generate-compose.py --edition=raw -o docker-compose.yml
#   python3 scripts/generate-compose.py --port-base=6000 -o docker-compose.yml
#
# Run tests:
#   ./scripts/run_tests.sh --version 2.4
#
# All configuration is now via command-line args to generate-compose.py:
#   --site-id             Site name (default: test)
#   --admin-password      Web UI password (default: test123)
#   --automation-password API password (default: testSecret123)
#   --edition             enterprise or raw (default: enterprise)
#   --port-base           Base port (default: 5000 -> 5020/5030/5040)

# =============================================================================
# Optional Development Settings
# =============================================================================
# TF_LOG=INFO
